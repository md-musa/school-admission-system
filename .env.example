# =============================================================================
# School Admission System – Environment Variables
# =============================================================================
# Copy this file to .env and adjust the values before running:
#   cp .env.example .env
#
# The docker-compose.yml uses these variables with safe defaults so that
# docker compose up works out-of-the-box without creating a .env file.
# Change the password in production!
# =============================================================================

# PostgreSQL Configuration
POSTGRES_DB=school_admission_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password

# Backend – Admission Hold Duration (seconds)
# How long a seat is held after a student applies before it is released.
HOLD_DURATION_SECONDS=600
